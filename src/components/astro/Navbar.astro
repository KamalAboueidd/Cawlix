---
import cawlixLogo from '../../assets/ICon.png';

const ENGINES = [
  {
    title: 'True-Cost Engine',
    desc: 'Deterministic out-of-pocket checkout calculation',
    href: '/engines/true-cost',
    icon: 'layers',
  },
  {
    title: 'Ghost-Discount Auditor',
    desc: '90-day baseline time-series fraud detection',
    href: '/engines/ghost-auditor',
    icon: 'shield-alert',
  },
  {
    title: 'Landed-Cost Arbitrage',
    desc: 'End-to-end US/EU to Egypt import modeling',
    href: '/engines/landed-cost',
    icon: 'globe',
  },
  {
    title: 'Anomaly Radar',
    desc: 'Sub-second pricing glitch & decimal error telemetry',
    href: '/engines/anomaly-radar',
    icon: 'zap',
  },
];

const SOLUTIONS = [
  {
    title: 'For Smart Shoppers',
    desc: 'Flagship electronics audits & cashback stacking',
    href: '/solutions/consumers',
    icon: 'shopping-bag',
  },
  {
    title: 'For Merchants & Resellers',
    desc: 'Real-time competitor tracking & ERP feeds',
    href: '/solutions/merchants',
    icon: 'store',
  },
];

const DIRECT_LINKS = [
  { label: 'Network Coverage', href: '/network/coverage' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Changelog', href: '/changelog' },
  { label: 'Blog', href: '/blog' },
  { label: 'Docs', href: '/docs' },
];
---

<header class="navbar-header">
  <div class="navbar-inner">
    <!-- Brand -->
    <div class="brand-group">
      <a href="/" class="brand-link">
        <img
          src={cawlixLogo.src || cawlixLogo}
          alt="Cawlix Logo"
          width="24"
          height="24"
          class="brand-icon"
        />
        <span class="brand-name">Cawlix</span>
      </a>

      <!-- Desktop Navigation Links (>= 768px) -->
      <nav class="desktop-nav">
        <!-- 1. Engines Dropdown -->
        <div class="nav-dropdown-wrapper">
          <button type="button" class="nav-trigger-btn">
            <span>Engines</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <div class="dropdown-menu mega-engines">
            <div class="dropdown-grid-2col">
              {ENGINES.map((item) => (
                <a href={item.href} class="dropdown-item">
                  <div class="clean-icon-wrapper">
                    {item.icon === 'layers' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                        <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
                        <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
                      </svg>
                    )}
                    {item.icon === 'shield-alert' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                        <path d="M12 8v4"/>
                        <path d="M12 16h.01"/>
                      </svg>
                    )}
                    {item.icon === 'globe' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                        <path d="M2 12h20"/>
                      </svg>
                    )}
                    {item.icon === 'zap' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
                      </svg>
                    )}
                  </div>
                  <div class="dropdown-text-group">
                    <span class="dropdown-title">{item.title}</span>
                    <span class="dropdown-desc">{item.desc}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 2. Solutions Dropdown -->
        <div class="nav-dropdown-wrapper">
          <button type="button" class="nav-trigger-btn">
            <span>Solutions</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <div class="dropdown-menu mega-solutions">
            <div class="dropdown-list-1col">
              {SOLUTIONS.map((item) => (
                <a href={item.href} class="dropdown-item">
                  <div class="clean-icon-wrapper">
                    {item.icon === 'shopping-bag' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                        <path d="M3 6h18"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                      </svg>
                    )}
                    {item.icon === 'store' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                        <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/>
                        <path d="M2 7h20"/>
                      </svg>
                    )}
                  </div>
                  <div class="dropdown-text-group">
                    <span class="dropdown-title">{item.title}</span>
                    <span class="dropdown-desc">{item.desc}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 3. Direct Header Links -->
        {DIRECT_LINKS.map((link) => (
          <a href={link.href} class="direct-nav-link">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Action CTA Group -->
    <div class="cta-group">
      <a href="/#showcase" class="cta-launch">
        Launch Tracker
      </a>

      <!-- Mobile Hamburger Toggle (< 768px) -->
      <button
        type="button"
        id="astro-mobile-toggle-btn"
        class="mobile-hamburger-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="hamburger-open-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="hamburger-close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer / Fullscreen Slide-Over (< 768px) -->
  <div id="astro-mobile-drawer" class="mobile-drawer-overlay" style="display: none;">
    <div class="mobile-drawer-content">
      <!-- Engines Section -->
      <div class="mobile-section">
        <span class="mobile-section-label">ENGINES</span>
        <div class="mobile-links-list">
          {ENGINES.map((item) => (
            <a href={item.href} class="mobile-nav-link">
              <div class="mobile-nav-item-body">
                <span class="mobile-nav-item-title">{item.title}</span>
                <span class="mobile-nav-item-desc">{item.desc}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Solutions Section -->
      <div class="mobile-section">
        <span class="mobile-section-label">SOLUTIONS</span>
        <div class="mobile-links-list">
          {SOLUTIONS.map((item) => (
            <a href={item.href} class="mobile-nav-link">
              <div class="mobile-nav-item-body">
                <span class="mobile-nav-item-title">{item.title}</span>
                <span class="mobile-nav-item-desc">{item.desc}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Direct Links Section -->
      <div class="mobile-section">
        <span class="mobile-section-label">PLATFORM &amp; DOCS</span>
        <div class="mobile-direct-grid">
          {DIRECT_LINKS.map((link) => (
            <a href={link.href} class="mobile-direct-link">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile CTA -->
      <div class="mobile-cta-wrap">
        <a href="/#showcase" class="mobile-launch-btn">
          Launch Tracker
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    width: 100%;
    background-color: rgba(10, 10, 10, 0.90);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .navbar-inner {
    max-width: 1280px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-icon {
    height: 24px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  /* ── Desktop Navigation ─────────────────────────────────────────────────── */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-dropdown-wrapper {
    position: relative;
    padding: 10px 0;
  }

  .nav-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
    border: none;
    color: #888888;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 150ms ease-in-out;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .nav-dropdown-wrapper:hover .nav-trigger-btn {
    color: #3ECF8E;
    background-color: transparent;
  }

  .nav-dropdown-wrapper:hover .chevron-icon {
    transform: rotate(180deg);
    color: #3ECF8E;
  }

  .chevron-icon {
    transition: transform 150ms ease, color 150ms ease-in-out;
    color: #737373;
  }

  /* ── Flyout Dropdowns (Institutional Minimalist Surface) ────────────────── */
  .dropdown-menu {
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    background: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.95);
    padding: 16px;
    border-radius: 8px;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 120ms ease, transform 120ms ease, visibility 120ms;
    pointer-events: none;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mega-engines {
    width: 540px;
  }

  .mega-solutions {
    width: 380px;
  }

  .dropdown-grid-2col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  .dropdown-list-1col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dropdown-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 6px;
    text-decoration: none;
    background: transparent;
  }

  .dropdown-item:hover {
    background-color: transparent;
  }

  .clean-icon-wrapper {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .dropdown-text-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .dropdown-title {
    font-family: var(--font-sans, system-ui, sans-serif);
    color: #FFFFFF;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 150ms ease-in-out;
  }

  .dropdown-item:hover .dropdown-title {
    color: #3ECF8E;
  }

  .dropdown-desc {
    color: #888888;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .direct-nav-link {
    padding: 6px 12px;
    border-radius: 6px;
    color: #888888;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    background: transparent;
    transition: color 150ms ease-in-out;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .direct-nav-link:hover {
    color: #3ECF8E;
    background-color: transparent;
  }

  /* ── Action CTA Group ───────────────────────────────────────────────────── */
  .cta-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta-launch {
    background-color: #3ECF8E;
    color: #0A0A0A;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-weight: 700;
    font-size: 0.75rem;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: background-color 140ms ease;
  }

  .cta-launch:hover {
    background-color: #34B27B;
  }

  .mobile-hamburger-btn {
    display: none;
    padding: 6px;
    background: transparent;
    border: none;
    color: #888888;
    cursor: pointer;
    transition: color 140ms ease;
  }

  .mobile-hamburger-btn:hover {
    color: #FFFFFF;
  }

  /* ── Mobile Fullscreen Slide-Over Drawer (< 768px) ─────────────────────── */
  .mobile-drawer-overlay {
    display: none;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none !important;
    }

    .mobile-hamburger-btn {
      display: block !important;
    }
  }

  @media (max-width: 768px) {
    .navbar-header {
      height: 56px !important;
    }

    .navbar-inner {
      padding: 0 16px !important;
    }

    .brand-icon {
      height: 22px !important;
    }

    .cta-launch {
      display: none;
    }

    .mobile-drawer-overlay {
      display: block;
      position: fixed;
      top: 56px;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 49;
      background: #0A0A0A;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .mobile-drawer-content {
      padding: 24px 20px 48px 20px;
      display: flex;
      flex-direction: column;
      gap: 28px;
      max-width: 520px;
      margin: 0 auto;
    }

    .mobile-section {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .mobile-section-label {
      font-family: var(--font-mono, monospace);
      font-size: 0.6875rem;
      font-weight: 600;
      color: #737373;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .mobile-links-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .mobile-nav-link {
      text-decoration: none;
      display: block;
      padding: 6px 0;
    }

    .mobile-nav-item-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .mobile-nav-item-title {
      font-family: var(--font-sans, system-ui, sans-serif);
      font-size: 0.9375rem;
      font-weight: 600;
      color: #FFFFFF;
    }

    .mobile-nav-item-desc {
      font-size: 0.75rem;
      color: #888888;
      line-height: 1.4;
    }

    .mobile-direct-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .mobile-direct-link {
      font-family: var(--font-sans, system-ui, sans-serif);
      font-size: 0.875rem;
      font-weight: 500;
      color: #A3A3A3;
      text-decoration: none;
      padding: 6px 0;
      transition: color 140ms ease;
    }

    .mobile-direct-link:hover {
      color: #3ECF8E;
    }

    .mobile-cta-wrap {
      margin-top: 8px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .mobile-launch-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      background-color: #3ECF8E;
      color: #0A0A0A;
      font-family: var(--font-sans, system-ui, sans-serif);
      font-size: 0.875rem;
      font-weight: 700;
      padding: 12px 16px;
      border-radius: 8px;
      text-decoration: none;
      box-sizing: border-box;
    }
  }
</style>

<script>
  // Mobile drawer toggle logic
  const toggleBtn = document.getElementById('astro-mobile-toggle-btn');
  const drawer = document.getElementById('astro-mobile-drawer');
  const openIcon = toggleBtn?.querySelector('.hamburger-open-icon') as HTMLElement;
  const closeIcon = toggleBtn?.querySelector('.hamburger-close-icon') as HTMLElement;

  let isOpen = false;

  function setDrawerState(open: boolean) {
    isOpen = open;
    if (drawer) {
      drawer.style.display = isOpen ? 'block' : 'none';
    }
    if (openIcon && closeIcon) {
      openIcon.style.display = isOpen ? 'none' : 'block';
      closeIcon.style.display = isOpen ? 'block' : 'none';
    }
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  toggleBtn?.addEventListener('click', () => {
    setDrawerState(!isOpen);
  });

  // Auto-close on link click
  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setDrawerState(false);
    });
  });

  // Auto-close on escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      setDrawerState(false);
    }
  });
</script>
