---
import cawlixLogo from '../../assets/ICon.png';

const ENGINES = [
  {
    title: 'True-Cost Engine',
    desc: 'Deterministic net checkout cost computation',
    href: '/engines/true-cost',
    icon: 'layers',
  },
  {
    title: 'Ghost-Discount Auditor',
    desc: '90-day time-series markdown validation',
    href: '/engines/ghost-auditor',
    badge: 'ZERO-DAY',
    icon: 'shield-alert',
  },
  {
    title: 'Landed-Cost Matrix',
    desc: 'US-to-Egypt import customs & FX calculation',
    href: '/engines/landed-cost',
    icon: 'globe',
  },
  {
    title: 'Anomaly Glitch Radar',
    desc: 'Sub-second error-pricing detection',
    href: '/engines/anomaly-radar',
    badge: 'LIVE',
    icon: 'zap',
  },
];

const SOLUTIONS = [
  {
    title: 'For Consumers',
    desc: 'Find genuine price drops, bank cashback, & coupons',
    href: '/solutions/power-shoppers',
    icon: 'shopping-bag',
  },
  {
    title: 'For Retailers & Resellers',
    desc: 'Competitive dynamic pricing & margin monitoring',
    href: '/solutions/retailers',
    icon: 'store',
  },
  {
    title: 'Global Arbitrage Traders',
    desc: 'Cross-border import spread & customs arbitrage',
    href: '/solutions/arbitrage',
    icon: 'arrow-right-left',
  },
];

const DEVELOPERS = [
  {
    title: 'Scraper Network Status',
    desc: 'Live telemetry nodes, health & probe latency',
    href: '/status',
    badge: '100%',
    icon: 'activity',
  },
  {
    title: 'Coverage Matrix',
    desc: '12 Egyptian stores & direct US freight corridors',
    href: '/network/coverage',
    icon: 'grid',
  },
  {
    title: 'API Sandbox',
    desc: 'REST endpoints, webhooks & SDK integrations',
    href: '/docs/api',
    icon: 'terminal',
  },
];

const DIRECT_LINKS = [
  { label: 'Pricing', href: '/pricing' },
  { label: 'Changelog', href: '/changelog' },
  { label: 'Blog', href: '/blog' },
  { label: 'Docs', href: '/docs' },
];
---

<header class="navbar-header">
  <div class="navbar-inner">
    <!-- Brand -->
    <div class="brand-group">
      <a href="/" class="brand-link">
        <img
          src={cawlixLogo.src || cawlixLogo}
          alt="Cawlix Logo"
          width="26"
          height="26"
          class="brand-icon"
        />
        <span class="brand-name">Cawlix</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="desktop-nav">
        <!-- 1. Engines Dropdown -->
        <div class="nav-dropdown-wrapper">
          <button type="button" class="nav-trigger-btn">
            <span>Engines</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <div class="dropdown-menu mega-engines">
            <div class="dropdown-grid-2col">
              {ENGINES.map((item) => (
                <a href={item.href} class="dropdown-item">
                  <div class="clean-icon-wrapper">
                    {item.icon === 'layers' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                        <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
                        <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
                      </svg>
                    )}
                    {item.icon === 'shield-alert' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                        <path d="M12 8v4"/>
                        <path d="M12 16h.01"/>
                      </svg>
                    )}
                    {item.icon === 'globe' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                        <path d="M2 12h20"/>
                      </svg>
                    )}
                    {item.icon === 'zap' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
                      </svg>
                    )}
                  </div>
                  <div class="dropdown-text-group">
                    <div class="dropdown-title-row">
                      <span class="dropdown-title">{item.title}</span>
                      {item.badge && <span class="dropdown-badge">{item.badge}</span>}
                    </div>
                    <span class="dropdown-desc">{item.desc}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 2. Solutions Dropdown -->
        <div class="nav-dropdown-wrapper">
          <button type="button" class="nav-trigger-btn">
            <span>Solutions</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <div class="dropdown-menu mega-solutions">
            <div class="dropdown-list-1col">
              {SOLUTIONS.map((item) => (
                <a href={item.href} class="dropdown-item">
                  <div class="clean-icon-wrapper">
                    {item.icon === 'shopping-bag' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                        <path d="M3 6h18"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                      </svg>
                    )}
                    {item.icon === 'store' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                        <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/>
                        <path d="M2 7h20"/>
                      </svg>
                    )}
                    {item.icon === 'arrow-right-left' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m16 3 4 4-4 4"/>
                        <path d="M20 7H4"/>
                        <path d="m8 21-4-4 4-4"/>
                        <path d="M4 17h16"/>
                      </svg>
                    )}
                  </div>
                  <div class="dropdown-text-group">
                    <span class="dropdown-title">{item.title}</span>
                    <span class="dropdown-desc">{item.desc}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 3. Developers Dropdown -->
        <div class="nav-dropdown-wrapper">
          <button type="button" class="nav-trigger-btn">
            <span>Developers</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <div class="dropdown-menu mega-developers">
            <div class="dropdown-list-1col">
              {DEVELOPERS.map((item) => (
                <a href={item.href} class="dropdown-item">
                  <div class="clean-icon-wrapper">
                    {item.icon === 'activity' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.48 12H2"/>
                      </svg>
                    )}
                    {item.icon === 'grid' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="7" height="7" x="3" y="3" rx="1"/>
                        <rect width="7" height="7" x="14" y="3" rx="1"/>
                        <rect width="7" height="7" x="14" y="14" rx="1"/>
                        <rect width="7" height="7" x="3" y="14" rx="1"/>
                      </svg>
                    )}
                    {item.icon === 'terminal' && (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3ECF8E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m4 17 6-6-6-6"/>
                        <path d="M12 19h8"/>
                      </svg>
                    )}
                  </div>
                  <div class="dropdown-text-group">
                    <div class="dropdown-title-row">
                      <span class="dropdown-title">{item.title}</span>
                      {item.badge && <span class="dropdown-badge">{item.badge}</span>}
                    </div>
                    <span class="dropdown-desc">{item.desc}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 4. Direct Links -->
        {DIRECT_LINKS.map((link) => (
          <a href={link.href} class="direct-nav-link">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Action CTA Group -->
    <div class="cta-group">
      <a href="/sign-in" class="cta-signin">
        Sign In
      </a>
      <a href="/#showcase" class="cta-launch">
        Launch Tracker
      </a>
    </div>
  </div>
</header>

<style>
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms ease, border-color 200ms ease, backdrop-filter 200ms ease;
  }

  .navbar-header.scrolled {
    background-color: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .navbar-inner {
    max-width: 1280px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-icon {
    height: 26px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    font-family: var(--font-sans);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-dropdown-wrapper {
    position: relative;
    padding: 10px 0;
  }

  .nav-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
    border: none;
    color: #888888;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 140ms ease;
    font-family: var(--font-sans);
  }

  .nav-dropdown-wrapper:hover .nav-trigger-btn {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-dropdown-wrapper:hover .chevron-icon {
    transform: rotate(180deg);
    color: #3ECF8E;
  }

  .chevron-icon {
    transition: transform 150ms ease, color 150ms ease;
    color: #737373;
  }

  /* Mega Menu Container */
  .dropdown-menu {
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    background: rgba(14, 14, 14, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 10px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.85);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 140ms ease, transform 140ms ease, visibility 140ms;
    pointer-events: none;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mega-engines {
    width: 480px;
  }

  .mega-solutions {
    width: 300px;
  }

  .mega-developers {
    width: 310px;
  }

  .dropdown-grid-2col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px 8px;
  }

  .dropdown-list-1col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .dropdown-item {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 6px 8px;
    border-radius: 6px;
    text-decoration: none;
    background: transparent;
  }

  .clean-icon-wrapper {
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dropdown-text-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .dropdown-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .dropdown-title {
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .dropdown-badge {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: #3ECF8E;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: transparent;
    border: none;
    padding: 0;
  }

  .dropdown-desc {
    color: #737373;
    font-size: 0.6875rem;
    line-height: 1.35;
  }

  .direct-nav-link {
    padding: 6px 12px;
    border-radius: 6px;
    color: #888888;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 140ms ease;
    font-family: var(--font-sans);
  }

  .direct-nav-link:hover {
    color: #FFFFFF;
  }

  /* Action CTA Group */
  .cta-group {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cta-signin {
    font-size: 0.875rem;
    font-weight: 600;
    color: #888888;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .cta-signin:hover {
    color: #FFFFFF;
  }

  .cta-launch {
    background-color: #3ECF8E;
    color: #0A0A0A;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: background-color 140ms ease;
  }

  .cta-launch:hover {
    background-color: #34B27B;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none !important;
    }
  }
</style>

<script>
  const nav = document.querySelector('.navbar-header');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 15) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };
    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
  }
</script>
