---
// Static hero section in Astro with Zero CLS and eager visual
const TICKER_ITEMS = [
  { value: '12', label: 'RETAILERS INDEXED' },
  { value: '90-DAY', label: 'PRICE VELOCITY' },
  { value: '<180MS', label: 'PROBE LATENCY' },
  { value: '0%', label: 'GHOST DEAL TOLERANCE', highlight: true },
];
---

<section
  class="hero-section-root"
  dir="ltr"
  style="display: flex; flex-direction: column; align-items: center; padding-top: 110px; padding-bottom: 40px; padding-left: 24px; padding-right: 24px; position: relative; background: #0A0A0A; overflow: hidden; text-align: center;"
>
  {/* Visual 1: Primary Hero Graphic with subtle radial fade mask */}
  <div
    aria-hidden="true"
    class="hero-globe-graphic"
    style="position: absolute; top: 60px; left: 50%; transform: translateX(-50%); width: 100%; max-width: 1240px; height: auto; aspect-ratio: 1672 / 941; pointer-events: none; z-index: 0; opacity: 0.28; -webkit-mask-image: radial-gradient(circle at 50% 48%, black 35%, rgba(0, 0, 0, 0.3) 65%, transparent 85%); mask-image: radial-gradient(circle at 50% 48%, black 35%, rgba(0, 0, 0, 0.3) 65%, transparent 85%);"
  >
    <img
      src="/landing/1.webp"
      alt="Cawlix Institutional Telemetry Infrastructure"
      width={1672}
      height={941}
      loading="eager"
      fetchpriority="high"
      style="width: 100%; height: auto; aspect-ratio: 1672 / 941; object-fit: cover; display: block;"
    />
  </div>

  {/* Ambient radial glow */}
  <div
    aria-hidden="true"
    class="hero-ambient-glow"
    style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 1000px; height: 520px; background: radial-gradient(ellipse at 50% 0%, rgba(62, 207, 142, 0.05) 0%, transparent 70%); pointer-events: none; z-index: 1;"
  ></div>

  {/* Hero First Fold */}
  <div
    class="hero-first-fold"
    style="max-width: 1040px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 24px; position: relative; z-index: 1;"
  >
    {/* Central Content Cluster */}
    <div class="hero-content-cluster">
      {/* Vercel Display Grade Headline with Multi-tone Narrative Contrast */}
      <h1
        class="text-display hero-title-responsive"
        style="font-size: clamp(1.85rem, 4.5vw, 4.25rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.12; max-width: 920px; margin: 0 auto; word-break: break-word; text-shadow: 0 2px 20px rgba(0, 0, 0, 0.85);"
      >
        <span style="color: #FFFFFF; font-weight: 500;">Institutional Price Intelligence. </span>
        <span class="text-contrast-tail">Engineered for absolute accuracy.</span>
      </h1>

      {/* Concise 2-line Subtitle */}
      <p
        class="hero-sub-responsive"
        style="font-size: 1.0625rem; color: #888888; line-height: 1.6; max-width: 660px; margin: 0 auto; letter-spacing: -0.01em;"
      >
        Stop paying ghost-inflated prices. Cawlix computes deterministic out-of-pocket costs
        across 12 Egyptian retailers and direct US import corridors in real-time.
      </p>

      {/* Action Area: Side by Side Buttons */}
      <div class="hero-actions-wrapper">
        <a
          href="#engines"
          class="hero-action-btn hero-btn-primary"
        >
          <span>Launch Tracker</span>
          <span style="display: inline-block; margin-left: 2px;">&rarr;</span>
        </a>
        <a
          href="#engines"
          class="hero-action-btn hero-btn-secondary"
        >
          <span>Docs</span>
        </a>
      </div>
    </div>

    {/* Borderless Horizontal Telemetry Ticker (Marquee on mobile) */}
    <div class="ticker-wrapper">
      <div class="ticker-track">
        <div class="ticker-group">
          {TICKER_ITEMS.map((item) => (
            <div class="ticker-item">
              <span style={{ color: item.highlight ? '#3ECF8E' : '#FFFFFF', fontWeight: 600 }}>
                {item.value}
              </span>
              <span>{item.label}</span>
            </div>
            <span class="ticker-dot">&middot;</span>
          ))}
        </div>

        {/* Duplicate group for continuous loop on mobile */}
        <div class="ticker-group ticker-group-duplicate" aria-hidden="true">
          {TICKER_ITEMS.map((item) => (
            <div class="ticker-item">
              <span style={{ color: item.highlight ? '#3ECF8E' : '#FFFFFF', fontWeight: 600 }}>
                {item.value}
              </span>
              <span>{item.label}</span>
            </div>
            <span class="ticker-dot">&middot;</span>
          ))}
        </div>
      </div>
    </div>
  </div>

  {/* Institutional Feature Showcase Header */}
  <div style="width: 100%; margin-top: 40px; text-align: center;">
    <span class="feature-group-label" style="margin-bottom: 12px;">
      Interactive Intelligence Console
    </span>
    <h2
      class="text-display"
      style="font-size: clamp(1.875rem, 3.8vw, 3rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.08; margin-bottom: 16px;"
    >
      <span style="color: #FFFFFF; font-weight: 500;">Live Telemetry Feeds & Market Probes </span>
      <span class="text-contrast-tail">across 12 Egyptian retailers.</span>
    </h2>
  </div>
</section>

<style>
  .hero-actions-wrapper {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    width: 100% !important;
    max-width: 270px !important;
    margin: 0 auto !important;
  }

  .hero-action-btn {
    flex: 1 1 0px !important;
    min-width: 0 !important;
    height: 35px !important;
    padding: 0 10px !important;
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    border-radius: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 5px !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    box-sizing: border-box !important;
    transition: all 140ms ease !important;
  }

  .hero-btn-primary {
    color: #0A0A0A !important;
    background-color: #3ECF8E !important;
    border: 1px solid #3ECF8E !important;
  }
  .hero-btn-primary:hover {
    background-color: #34B77B !important;
    border-color: #34B77B !important;
  }

  .hero-btn-secondary {
    color: #EDEDED !important;
    background-color: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
  }
  .hero-btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.07) !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
    color: #FFFFFF !important;
  }

  /* Telemetry Ticker Marquee */
  .ticker-wrapper {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 14px 0;
  }

  .ticker-track {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .ticker-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #888888;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ticker-dot {
    color: rgba(255, 255, 255, 0.15);
    user-select: none;
  }

  .hero-content-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .ticker-group-duplicate {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-section-root {
      padding-top: 56px !important;
      padding-bottom: 16px !important;
      background: #0A0A0A !important;
    }

    .hero-ambient-glow {
      display: none !important;
    }

    /* Mobile 100vh / 100dvh Exact Fit First Fold */
    .hero-first-fold {
      min-height: calc(100dvh - 56px) !important;
      min-height: calc(100vh - 56px);
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      align-items: center !important;
      padding: 16px 16px 12px 16px !important;
      box-sizing: border-box !important;
      position: relative !important;
      background: transparent !important;
    }

    /* Central cluster vertically centered in the fold */
    .hero-content-cluster {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 14px !important;
      text-align: center !important;
      margin: auto 0 !important;
      position: relative !important;
      z-index: 2 !important;
      background: transparent !important;
      width: 100% !important;
      max-width: 360px !important;
    }

    /* Globe positioned gracefully as ambient depth behind the action area */
    .hero-globe-graphic {
      top: 140px !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      transform-origin: center center !important;
      width: 135% !important;
      max-width: 520px !important;
      height: 400px !important;
      opacity: 0.28 !important;
      overflow: hidden !important;
      mix-blend-mode: screen !important;
      background: transparent !important;
      pointer-events: none !important;
      -webkit-mask-image: radial-gradient(circle at 50% 50%, black 45%, rgba(0, 0, 0, 0.3) 75%, transparent 100%) !important;
      mask-image: radial-gradient(circle at 50% 50%, black 45%, rgba(0, 0, 0, 0.3) 75%, transparent 100%) !important;
    }

    .hero-globe-graphic img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center !important;
      mix-blend-mode: screen !important;
      background: transparent !important;
    }

    .hero-title-responsive {
      font-size: clamp(1.8rem, 7.2vw, 2.3rem) !important;
      line-height: 1.14 !important;
      letter-spacing: -0.035em !important;
      margin: 0 auto !important;
      max-width: 350px !important;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9);
    }

    .hero-sub-responsive {
      font-size: 0.84rem !important;
      line-height: 1.55 !important;
      max-width: 320px !important;
      margin: 2px auto 0 auto !important;
      color: #9CA3AF !important;
      letter-spacing: -0.01em !important;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
    }

    .hero-actions-wrapper {
      max-width: 270px !important;
      gap: 10px !important;
      margin: 8px auto 0 auto !important;
    }

    .hero-action-btn {
      height: 38px !important;
      max-height: 38px !important;
      line-height: 38px !important;
      font-size: 0.8125rem !important;
      padding: 0 14px !important;
      border-radius: 8px !important;
      gap: 6px !important;
    }

    /* Auto-marquee ticker on mobile */
    .ticker-wrapper {
      padding: 9px 0 !important;
      max-width: 100% !important;
      margin-top: auto !important;
      margin-bottom: 12px !important;
      border-top: 1px solid rgba(255, 255, 255, 0.06) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 1) 8%, rgba(0, 0, 0, 1) 92%, transparent 100%) !important;
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 1) 8%, rgba(0, 0, 0, 1) 92%, transparent 100%) !important;
    }

    .ticker-track {
      justify-content: flex-start !important;
      width: max-content !important;
      animation: cawlixTickerMarquee 16s linear infinite !important;
      will-change: transform;
    }

    .ticker-track:hover,
    .ticker-track:active {
      animation-play-state: paused !important;
    }

    .ticker-group {
      gap: 16px !important;
      padding-right: 16px !important;
      font-size: 0.6875rem !important;
      letter-spacing: 0.04em !important;
      flex-shrink: 0 !important;
    }

    .ticker-group-duplicate {
      display: flex !important;
    }
  }

  @keyframes cawlixTickerMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
