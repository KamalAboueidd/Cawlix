---
// Vercel-style "Add Target SKU" Modal Component
---

<div
  id="add-sku-modal-overlay"
  class="add-sku-modal-overlay"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-headline"
>
  <div class="add-sku-frame">
    <!-- Header -->
    <div class="add-sku-header">
      <div>
        <h2 id="modal-headline" class="add-sku-title">Track Target SKU Node</h2>
        <p class="add-sku-subtitle">
          Enter an Egyptian retail node URL or canonical identifier to begin continuous telemetry ingestion.
        </p>
      </div>
      <button
        type="button"
        id="btn-close-sku-modal"
        class="add-sku-esc-badge"
        aria-label="Close modal"
        title="Close"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Error Banner -->
    <div id="modal-error-banner" class="modal-error-banner" style="display: none;"></div>

    <!-- Form -->
    <form id="add-target-sku-form" class="add-sku-form" novalidate>
      <!-- Field 1: Retail Node URL or Canonical SKU -->
      <div class="form-group">
        <label for="sku-url-input" class="form-label font-mono">
          RETAIL NODE URL OR CANONICAL SKU
        </label>
        <input
          id="sku-url-input"
          type="text"
          required
          placeholder="https://www.amazon.eg/dp/... or B0CHX..."
          class="form-input font-mono"
          autocomplete="off"
        />
      </div>

      <!-- Field 2: Retailer Node Selector -->
      <div class="form-group">
        <label class="form-label font-mono">DOMESTIC RETAIL NODE</label>
        <div class="node-selector-row" id="node-selector-row">
          <button type="button" class="node-tag active" data-node="AMZN_EG" data-domain="node.amazon.eg">AMZN_EG</button>
          <button type="button" class="node-tag" data-node="NOON_EG" data-domain="node.noon.eg">NOON_EG</button>
          <button type="button" class="node-tag" data-node="BTECH_EG" data-domain="node.btech.eg">BTECH_EG</button>
          <button type="button" class="node-tag" data-node="2B_EG" data-domain="node.2b.com.eg">2B_EG</button>
          <button type="button" class="node-tag" data-node="RAYA_EG" data-domain="node.rayashop.com">RAYA_EG</button>
        </div>
        <input type="hidden" id="selected-retail-node" value="AMZN_EG" />
        <input type="hidden" id="selected-retail-domain" value="node.amazon.eg" />
      </div>

      <!-- Field 3: Target Alert Threshold Price (Optional) -->
      <div class="form-group">
        <label for="target-alert-price-input" class="form-label font-mono">
          TARGET ALERT THRESHOLD (EGP)
        </label>
        <div class="currency-input-wrap">
          <span class="currency-prefix font-mono">EGP</span>
          <input
            id="target-alert-price-input"
            type="number"
            min="0"
            step="10"
            placeholder="e.g. 27500 (triggers instant alert when shelf drops below)"
            class="currency-field font-mono"
          />
        </div>
      </div>

      <!-- Field 4: Glitch Radar Notification Toggle -->
      <div class="glitch-toggle-wrap">
        <label class="glitch-label-container">
          <input type="checkbox" id="toggle-glitch-radar" class="glitch-checkbox" checked />
          <span class="glitch-custom-checkbox"></span>
          <span class="glitch-text">
            Instant Webhook/Email dispatch if a sub-second price glitch (&gt;30% drop) is detected.
          </span>
        </label>
      </div>

      <!-- Footer Actions -->
      <div class="modal-footer-actions">
        <button type="button" id="btn-cancel-sku-modal" class="btn-cancel-modal">
          Cancel
        </button>
        <button type="submit" id="btn-submit-telemetry" class="btn-initialize-telemetry">
          <span id="btn-submit-label">Initialize Telemetry</span>
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  .add-sku-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    animation: fadeInModal 140ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInModal {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .add-sku-frame {
    background-color: #000000;
    border: 1px solid #1F1F1F;
    border-radius: 12px;
    max-width: 520px;
    width: 100%;
    padding: 24px;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.95);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 20px;
    color: var(--text-primary);
  }

  [dir="rtl"] .add-sku-frame {
    text-align: right;
  }

  /* Header */
  .add-sku-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .add-sku-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }

  .add-sku-subtitle {
    margin: 6px 0 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .add-sku-esc-badge {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 120ms ease;
    flex-shrink: 0;
  }

  .add-sku-esc-badge:hover {
    color: #10B981;
    background: transparent;
    border: none;
  }

  /* Error Banner */
  .modal-error-banner {
    color: #FB7185;
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    line-height: 1.45;
    padding: 2px 0;
    border: none;
    background-color: transparent;
  }

  /* Form */
  .add-sku-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
    display: block;
  }

  .form-input {
    background-color: var(--bg);
    border: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-primary);
    padding: 0 14px;
    height: 40px;
    border-radius: 6px;
    width: 100%;
    outline: none;
    box-sizing: border-box;
    transition: border-color 140ms ease;
  }

  .form-input:focus {
    border-color: var(--border-hover);
  }

  .form-input::placeholder {
    color: var(--text-subtle);
  }

  /* Domestic Node Selector */
  .node-selector-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .node-tag {
    background-color: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 500;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 130ms ease;
  }

  .node-tag:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .node-tag.active {
    background-color: var(--surface-hover);
    border-color: var(--text-primary);
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Currency Input Wrapper */
  .currency-input-wrap {
    display: flex;
    align-items: center;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    height: 40px;
    overflow: hidden;
    transition: border-color 140ms ease;
  }

  .currency-input-wrap:focus-within {
    border-color: var(--border-hover);
  }

  .currency-prefix {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0 12px;
    background-color: var(--surface);
    height: 100%;
    display: flex;
    align-items: center;
    border-right: 1px solid var(--border);
    user-select: none;
  }

  [dir="rtl"] .currency-prefix {
    border-right: none;
    border-left: 1px solid var(--border);
  }

  .currency-field {
    flex: 1;
    background: transparent;
    border: none;
    font-size: 0.75rem;
    color: var(--text-primary);
    padding: 0 12px;
    height: 100%;
    outline: none;
  }

  .currency-field::placeholder {
    color: var(--text-subtle);
  }

  /* Glitch Radar Checkbox */
  .glitch-toggle-wrap {
    padding: 10px 12px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .glitch-label-container {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }

  .glitch-checkbox {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .glitch-custom-checkbox {
    width: 15px;
    height: 15px;
    border: 1px solid var(--border);
    background-color: var(--surface);
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 1px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 120ms ease;
  }

  .glitch-checkbox:checked ~ .glitch-custom-checkbox {
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .glitch-checkbox:checked ~ .glitch-custom-checkbox::after {
    content: '';
    width: 4px;
    height: 8px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px;
  }

  .glitch-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Modal Footer */
  .modal-footer-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  [dir="rtl"] .modal-footer-actions {
    justify-content: flex-start;
  }

  .btn-cancel-modal {
    background: transparent;
    border: none;
    font-size: 0.75rem;
    color: var(--text-muted);
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 4px;
    transition: color 120ms ease;
  }

  .btn-cancel-modal:hover {
    color: var(--text-primary);
  }

  .btn-initialize-telemetry {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0 16px;
    height: 36px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: opacity 140ms ease;
  }

  .btn-initialize-telemetry:hover {
    opacity: 0.88;
  }

  .btn-initialize-telemetry:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .init-bolt-icon {
    flex-shrink: 0;
  }
</style>
