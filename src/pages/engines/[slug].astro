---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/astro/Navbar.astro';
import Footer from '../../components/astro/Footer.astro';

export function getStaticPaths() {
  // All 4 institutional engines now have dedicated static pages:
  // true-cost.astro, ghost-auditor.astro, landed-cost.astro, anomaly-radar.astro
  return [];
}

const { engine } = Astro.props;
---

<Layout
  title={`${engine.title} — Cawlix Institutional Engine`}
  description={engine.summary}
>
  <Navbar />

  <main style="min-height: 100vh; background-color: #0A0A0A; padding-top: 130px; padding-bottom: 100px;">
    <div style="max-width: 960px; margin: 0 auto; padding: 0 24px;">
      <!-- Engine Meta Header -->
      <div style="margin-bottom: 48px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #3ECF8E; font-weight: 500;">
            {engine.id}
          </span>
          <span style="color: rgba(255, 255, 255, 0.2);">·</span>
          <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: #737373; text-transform: uppercase;">
            {engine.tag}
          </span>
        </div>

        <h1
          class="text-display"
          style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.08; margin: 0 0 20px 0;"
        >
          <span style="color: #FFFFFF;">{engine.title}</span>
        </h1>

        <p style="font-size: 1.125rem; color: #888888; line-height: 1.6; max-width: 760px; margin: 0;">
          {engine.summary}
        </p>
      </div>

      <!-- Specs Metric Bar (Borderless) -->
      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding: 20px 0; margin-bottom: 48px;"
      >
        {engine.specs.map((spec) => (
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.625rem; color: #737373; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.06em;">
              {spec.label}
            </div>
            <div style="font-family: var(--font-mono); font-size: 1.125rem; font-weight: 600; color: #3ECF8E;">
              {spec.value}
            </div>
          </div>
        ))}
      </div>

      <!-- Detailed Breakdown Section -->
      <div
        style="background: transparent; border: none; border-radius: 0; padding: 0; margin-bottom: 48px;"
      >
        <span class="feature-group-label" style="color: #3ECF8E; margin-bottom: 12px;">
          Architecture Deep Dive
        </span>
        <h2 style="font-size: 1.5rem; font-weight: 500; color: #FFFFFF; margin: 0 0 16px 0; letter-spacing: -0.02em;">
          Engineering Overview &amp; Execution Paradigm
        </h2>
        <p style="font-size: 0.9375rem; color: #A3A3A3; line-height: 1.7; margin: 0 0 32px 0;">
          {engine.description}
        </p>

        <!-- Logic Sequence -->
        <span class="feature-group-label" style="color: #737373; margin-bottom: 14px;">
          Deterministic Logic Pipeline
        </span>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          {engine.logicSteps.map((step, idx) => (
            <div
              style="display: flex; align-items: baseline; gap: 14px; padding: 10px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.04); font-family: var(--font-mono); font-size: 0.8125rem; color: #EDEDED;"
            >
              <span style={{ color: '#3ECF8E', fontWeight: 600 }}>0{idx + 1}</span>
              <span>{step}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Action Footer -->
      <div
        style="display: flex; justify-content: space-between; align-items: center; padding: 24px 0; border-top: 1px solid rgba(255, 255, 255, 0.05); flex-wrap: wrap; gap: 16px;"
      >
        <div>
          <div style="color: #FFFFFF; font-weight: 500; font-size: 1rem; margin-bottom: 4px;">
            Test {engine.title} on Live Retail Data
          </div>
          <div style="color: #888888; font-size: 0.8125rem;">
            Experience the interactive telemetry stream in our live showcase console.
          </div>
        </div>

        <a
          href="/#showcase"
          style="background: #3ECF8E; color: #0A0A0A; font-weight: 700; font-size: 0.875rem; padding: 10px 20px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;"
        >
          Launch Interactive Console &rarr;
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
