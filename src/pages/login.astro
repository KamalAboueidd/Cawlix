---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sign in — Cawlix Telemetry"
  description="Enter your telemetry terminal and monitoring engine."
>
  <div class="auth-viewport">
    
    <!-- Top Spacer / Brand Anchor -->
    <div class="brand-top-anchor">
      <a href="/" class="brand-link" aria-label="Return to Cawlix Terminal">
        <svg width="28" height="28" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4L6 14V34L24 44L42 34V14L24 4Z" stroke="#3ECF8E" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M24 14L14 20V30L24 36L34 30V20L24 14Z" fill="rgba(62, 207, 142, 0.12)" stroke="#3ECF8E" stroke-width="1.75" />
          <circle cx="24" cy="24" r="3" fill="#3ECF8E" />
        </svg>
      </a>
    </div>

    <!-- Minimal Form Shell (Vercel / Supabase Spec) -->
    <div class="auth-card-shell">
      
      <!-- Header -->
      <header class="card-header">
        <h1 class="card-title">Sign in to Cawlix</h1>
        <p class="card-subtitle">Enter your telemetry terminal and monitoring engine.</p>
      </header>

      <!-- 1-Click Exclusive Google OAuth Provider -->
      <div class="oauth-section">
        <button type="button" id="btn-google-oauth" class="btn-google">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <span>Continue with Google</span>
        </button>
      </div>

      <!-- Institutional Divider -->
      <div class="divider-wrap">
        <div class="divider-line"></div>
        <span class="divider-badge">OR</span>
      </div>

      <!-- Auth Method Switcher (Password vs Magic Link) -->
      <div class="auth-tabs">
        <button type="button" id="tab-password" class="auth-tab auth-tab-active">Credentials</button>
        <button type="button" id="tab-magic" class="auth-tab">Magic Link</button>
      </div>

      <!-- Credentials Form -->
      <form id="login-form" class="auth-form" novalidate>
        
        <!-- Email Field -->
        <div class="form-field">
          <label for="email-input" class="field-label">EMAIL ADDRESS</label>
          <input
            id="email-input"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="name@domain.com"
            class="field-input font-mono"
          />
        </div>

        <!-- Password Field (Conditional for password tab) -->
        <div class="form-field" id="password-group">
          <div class="field-label-split">
            <label for="password-input" class="field-label">PASSWORD</label>
            <a href="#reset" id="link-forgot-pw" class="field-aux-link">Forgot password?</a>
          </div>
          <input
            id="password-input"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="field-input font-mono"
          />
        </div>

        <!-- Inline Error Banner (Borderless) -->
        <div id="auth-error" class="auth-error-banner" style="display: none;"></div>

        <!-- Action Button -->
        <button type="submit" id="btn-submit" class="btn-primary">
          <span id="btn-label">Continue with Email</span>
        </button>
      </form>

      <!-- Micro-Legal & Account Switcher -->
      <footer class="card-footer">
        <p class="account-switcher">
          Don't have an account? <a href="/register" class="link-emerald">Sign up</a>
        </p>
        <p class="legal-notice">
          By signing in, you agree to the Cawlix Telemetry Terms and Security Protocol.
        </p>
      </footer>

    </div>

    <!-- Minimal Viewport Footer Telemetry -->
    <div class="viewport-telemetry">
      <span class="telemetry-dot">●</span> ALL RECOGNITION NODES OPERATIONAL &middot; STRICT ENCRYPTION (AES-256)
    </div>

  </div>
</Layout>

<style>
  .auth-viewport {
    min-height: 100vh;
    background-color: #0A0A0A;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 40px 16px 28px 16px;
    box-sizing: border-box;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .brand-top-anchor {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition: transform 150ms ease;
  }

  .brand-link:hover {
    transform: scale(1.05);
  }

  /* Form Shell: Max 380px Vercel / Supabase Spec */
  .auth-card-shell {
    max-width: 380px;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 32px;
    background: rgba(13, 13, 13, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-sizing: border-box;
    margin-bottom: auto;
  }

  .card-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .card-subtitle {
    font-size: 0.75rem;
    color: #737373;
    margin-top: 6px;
    margin-bottom: 0;
    line-height: 1.5;
  }

  /* OAuth Section */
  .oauth-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-google {
    width: 100%;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.02);
    color: #EDEDED;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .btn-google:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Institutional Divider */
  .divider-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 22px 0;
  }

  .divider-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .divider-badge {
    position: relative;
    background-color: #0D0D0D;
    padding: 0 8px;
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    color: #525252;
    letter-spacing: 0.06em;
  }

  /* Tabs */
  .auth-tabs {
    display: flex;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 18px;
    gap: 16px;
  }

  .auth-tab {
    background: transparent;
    border: none;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #737373;
    padding: 0 0 8px 0;
    cursor: pointer;
    position: relative;
    transition: color 140ms ease;
  }

  .auth-tab:hover {
    color: #EDEDED;
  }

  .auth-tab-active {
    color: #3ECF8E !important;
    border-bottom: 2px solid #3ECF8E;
  }

  /* Form Elements */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
  }

  .field-label {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    color: #737373;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .field-label-split {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field-aux-link {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    color: #737373;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .field-aux-link:hover {
    color: #3ECF8E;
  }

  .field-input {
    background-color: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #EDEDED;
    font-size: 0.875rem;
    padding: 0 14px;
    height: 40px;
    border-radius: 6px;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .field-input::placeholder {
    color: #525252;
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
  }

  .field-input:focus {
    border-color: #3ECF8E;
    box-shadow: 0 0 0 1px #3ECF8E;
  }

  .auth-error-banner {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: #EF4444;
    line-height: 1.4;
    padding-top: 4px;
  }

  .btn-primary {
    background-color: #3ECF8E;
    color: #0A0A0A;
    font-weight: 700;
    font-size: 0.875rem;
    height: 40px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background-color 150ms ease;
    width: 100%;
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary:hover {
    background-color: #34B27B;
  }

  /* Footer */
  .card-footer {
    margin-top: 24px;
    text-align: center;
  }

  .account-switcher {
    font-size: 0.75rem;
    color: #737373;
    margin: 0;
  }

  .link-emerald {
    color: #EDEDED;
    text-decoration: none;
    font-weight: 500;
    transition: color 140ms ease;
  }

  .link-emerald:hover {
    color: #3ECF8E;
  }

  .legal-notice {
    font-size: 11px;
    color: #525252;
    margin-top: 10px;
    margin-bottom: 0;
    line-height: 1.5;
  }

  /* Bottom Telemetry Readout */
  .viewport-telemetry {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    color: #525252;
    letter-spacing: 0.04em;
    text-align: center;
    margin-top: 32px;
  }

  .telemetry-dot {
    color: #3ECF8E;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  let currentMode: 'password' | 'magic' = 'password';

  const tabPassword = document.getElementById('tab-password');
  const tabMagic = document.getElementById('tab-magic');
  const passwordGroup = document.getElementById('password-group');
  const passwordInput = document.getElementById('password-input') as HTMLInputElement | null;
  const emailInput = document.getElementById('email-input') as HTMLInputElement | null;
  const btnSubmit = document.getElementById('btn-submit');
  const btnLabel = document.getElementById('btn-label');
  const authError = document.getElementById('auth-error');
  const btnGoogle = document.getElementById('btn-google-oauth');
  const form = document.getElementById('login-form');

  function showError(msg: string) {
    if (authError) {
      authError.textContent = msg;
      authError.style.display = 'block';
    }
  }

  function clearError() {
    if (authError) {
      authError.textContent = '';
      authError.style.display = 'none';
    }
  }

  // Tab switching
  tabPassword?.addEventListener('click', () => {
    currentMode = 'password';
    tabPassword.classList.add('auth-tab-active');
    tabMagic?.classList.remove('auth-tab-active');
    if (passwordGroup) passwordGroup.style.display = 'flex';
    if (passwordInput) passwordInput.required = true;
    if (btnLabel) btnLabel.textContent = 'Continue with Email';
    clearError();
  });

  tabMagic?.addEventListener('click', () => {
    currentMode = 'magic';
    tabMagic.classList.add('auth-tab-active');
    tabPassword?.classList.remove('auth-tab-active');
    if (passwordGroup) passwordGroup.style.display = 'none';
    if (passwordInput) passwordInput.required = false;
    if (btnLabel) btnLabel.textContent = 'Send Magic Link';
    clearError();
  });

  // Google OAuth Handler
  btnGoogle?.addEventListener('click', async () => {
    clearError();
    try {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/tracker` },
      });
      if (error) showError(error.message);
    } catch (err: any) {
      showError(err.message || 'Google authentication failed.');
    }
  });

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const email = emailInput?.value.trim() || '';
    if (!email) {
      showError('Please enter a valid email address.');
      return;
    }

    if (btnSubmit) {
      btnSubmit.setAttribute('disabled', 'true');
      btnSubmit.style.opacity = '0.6';
    }

    try {
      if (currentMode === 'password') {
        const password = passwordInput?.value || '';
        if (!password) {
          showError('Please enter your password.');
          return;
        }

        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) {
          showError(error.message);
        } else {
          window.location.href = '/tracker';
        }
      } else {
        const { error } = await supabase.auth.signInWithOtp({
          email,
          options: { emailRedirectTo: `${window.location.origin}/tracker` },
        });
        if (error) {
          showError(error.message);
        } else {
          if (authError) {
            authError.style.color = '#3ECF8E';
            authError.textContent = '✓ Magic link dispatched. Check your inbox.';
            authError.style.display = 'block';
          }
        }
      }
    } catch (err: any) {
      showError(err.message || 'Authentication error.');
    } finally {
      if (btnSubmit) {
        btnSubmit.removeAttribute('disabled');
        btnSubmit.style.opacity = '1';
      }
    }
  });
</script>
