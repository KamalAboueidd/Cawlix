  // 1. Theme Management (Dark & Light Foundation)
  function initTheme() {
    const savedTheme = localStorage.getItem('cawlix-theme') || 'dark';
    setTheme(savedTheme);
  }

  function setTheme(theme: string) {
    currentTheme = theme;
    localStorage.setItem('cawlix-theme', theme);
    if (root) root.setAttribute('data-theme', theme);
    document.documentElement.setAttribute('data-theme', theme);

    if (theme === 'light') {
      if (themeSunIcon) themeSunIcon.style.display = 'block';
      if (themeMoonIcon) themeMoonIcon.style.display = 'none';
      if (themeLabelText) themeLabelText.textContent = 'Light';
    } else {
      if (themeSunIcon) themeSunIcon.style.display = 'none';
      if (themeMoonIcon) themeMoonIcon.style.display = 'block';
      if (themeLabelText) themeLabelText.textContent = 'Dark';
    }
  }

  btnThemeToggle?.addEventListener('click', () => {
    setTheme(currentTheme === 'dark' ? 'light' : 'dark');
  });

  // 2. Language Management (English Only)
  function initLang() {
    try {
      localStorage.removeItem('cawlix-lang');
    } catch {}
    setLang('en');
  }

  function setLang(_lang: string) {
    currentLang = 'en';
    const dir = 'ltr';
    if (root) {
      root.setAttribute('dir', dir);
      root.setAttribute('lang', 'en');
    }
    document.documentElement.setAttribute('dir', dir);
    document.documentElement.setAttribute('lang', 'en');

    if (btnLangEn) {
      btnLangEn.classList.add('active');
    }
    if (btnLangAr) {
      btnLangAr.classList.remove('active');
    }
  }

    // Apply translations
    const dict = I18N[lang as 'en' | 'ar'] || I18N.en;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key as keyof typeof dict]) {
        el.textContent = dict[key as keyof typeof dict];
      }
    });

    if (searchInput) {
      searchInput.placeholder = dict.searchPlaceholder;
    }

    renderRows(trackedItems);

