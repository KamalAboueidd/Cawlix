---
import Layout from '../../layouts/Layout.astro';
import AddSkuModal from '../../components/console/AddSkuModal.astro';
---

<Layout
  title="Console — Cawlix Telemetry Terminal"
  description="Vercel-inspired minimalist SKU price telemetry terminal and domestic retail node monitor."
>
  <!-- Google Font Cairo for Arabic Optical Density Match -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="cawlix-console-root" id="console-root" data-theme="dark" dir="ltr">
    
    <!-- ── Row 1: Brand & Scope + Utilities ── -->
    <header class="header-row-1">
      <div class="header-scope">
        <!-- Cawlix Minimal Mark -->
        <a href="/" class="brand-link" aria-label="Cawlix Home">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="brand-icon">
            <circle cx="12" cy="12" r="9" stroke="var(--text-primary)" stroke-width="1.25" stroke-opacity="0.3" />
            <circle cx="12" cy="12" r="5" stroke="var(--text-primary)" stroke-width="1.25" stroke-opacity="0.6" />
            <circle cx="12" cy="12" r="1.5" fill="var(--text-primary)" />
            <line x1="12" y1="12" x2="19" y2="5" stroke="var(--text-primary)" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="brand-title font-mono">Cawlix</span>
        </a>

        <span class="slash-divider">/</span>

        <!-- Project Scope -->
        <div class="scope-selector" id="scope-selector">
          <span class="scope-avatar-dot"></span>
          <span class="scope-handle font-mono" id="scope-user-name">kamal-core</span>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </div>
      </div>

      <!-- Utilities: Theme Toggle + Language Switcher + User Avatar -->
      <div class="header-utilities">
        <!-- Theme Toggle (Discrete Sun/Moon Icon + Text) -->
        <button type="button" id="btn-theme-toggle" class="utility-btn font-mono" title="Toggle Theme" aria-label="Toggle Theme">
          <svg id="theme-sun-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="theme-moon-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span id="theme-label-text">Dark</span>
        </button>

        <div class="util-divider"></div>

        <!-- User Profile Avatar -->
        <div class="user-avatar-wrap">
          <button type="button" id="btn-user-avatar" class="user-avatar-circle" aria-label="User menu">
            <span id="user-avatar-initial">K</span>
          </button>
          <div id="user-dropdown-menu" class="user-dropdown-menu" style="display: none;">
            <div class="dropdown-header font-mono" id="dropdown-user-email">developer@cawlix.com</div>
            <div class="menu-divider"></div>
            <a href="/tracker" class="menu-link" data-i18n="navTracker">Telemetry Tracker</a>
            <a href="/docs" class="menu-link" data-i18n="navDocs">API Documentation</a>
            <a href="/engines/true-cost" class="menu-link" data-i18n="navTrueCost">True-Cost Engine</a>
            <div class="menu-divider"></div>
            <button type="button" id="btn-sign-out" class="menu-btn-signout" data-i18n="btnSignOut">Sign Out</button>
          </div>
        </div>
      </div>
    </header>

    <!-- ── Row 2: Borderless Text Tabs ── -->
    <nav class="header-row-2" aria-label="Console Subnavigation">
      <div class="nav-tabs">
        <button type="button" class="nav-tab active" data-tab="overview" data-i18n="tabOverview">Overview</button>
        <button type="button" class="nav-tab" data-tab="watchlist" data-i18n="tabWatchlist">Watchlist</button>
        <button type="button" class="nav-tab" data-tab="radar" data-i18n="tabRadar">Radar</button>
        <button type="button" class="nav-tab" data-tab="settings" data-i18n="tabSettings">Settings</button>
      </div>
    </nav>

    <!-- ── Main Canvas ── -->
    <main class="console-body">
      <div class="console-container">

        <!-- Flat Command Search Bar + High-Contrast Primary Button -->
        <section class="command-bar">
          <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-subtle)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="sku-search-input"
              placeholder="Search tracked SKUs, nodes, or retailers..."
              class="search-input font-mono"
              autocomplete="off"
            />
            <button type="button" id="btn-clear-search" class="clear-search-btn" style="display: none;">&times;</button>
          </div>

          <button type="button" id="btn-add-sku" class="btn-primary-add font-mono">
            <span class="plus-icon">+</span>
            <span data-i18n="btnAddSku">Add Target SKU</span>
          </button>
        </section>

        <!-- Unadorned Tracked Items List -->
        <section class="tracked-list-section">
          <!-- Table Header -->
          <div class="list-header font-mono">
            <span class="col-title" data-i18n="colTitle">ITEM / TITLE</span>
            <span class="col-store" data-i18n="colStore">STORE</span>
            <span class="col-price" data-i18n="colPrice">PRICE</span>
            <span class="col-delta" data-i18n="colDelta">90D BASELINE DELTA</span>
            <span class="col-time" data-i18n="colTime">LAST CHECK</span>
            <span class="col-action" data-i18n="colAction">ACTION</span>
          </div>

          <!-- Loading state -->
          <div id="loading-indicator" class="loading-state font-mono" style="display: none;">
            INITIALIZING PROBE NODES...
          </div>

          <!-- Dynamic Rows -->
          <div id="sku-rows-container" class="list-rows-container">
            <!-- Dynamically populated rows -->
          </div>
        </section>

      </div>
    </main>

    <!-- ── Vercel-style Slide-Over Drawer (Telemetry Inspector) ── -->
    <div id="telemetry-drawer-overlay" class="drawer-overlay" style="display: none;">
      <div class="drawer-backdrop" id="drawer-backdrop"></div>
      <aside class="drawer-panel" id="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-item-title">
        
        <!-- Drawer Top Control Bar -->
        <div class="drawer-topbar">
          <div class="drawer-scope-pill font-mono">
            <span data-i18n="drawerLiveTelemetry">TELEMETRY PROBE</span>
          </div>
          <button type="button" id="btn-close-drawer" class="drawer-close-btn font-mono" aria-label="Close Drawer" title="Close (Esc)">
            <span>ESC</span>
          </button>
        </div>

        <!-- Drawer Content Container (Injected via JS) -->
        <div class="drawer-content" id="drawer-content">
          <!-- Populated dynamically -->
        </div>

      </aside>
    </div>

    <!-- Vercel-style Add SKU Modal -->
    <AddSkuModal />

  </div>
</Layout>

<style>
  /* ── 1. Design System Tokens (Dark & Light Mode Architecture) ── */
  :root[data-theme="dark"],
  .cawlix-console-root[data-theme="dark"] {
    --bg: #000000;
    --surface: #0a0a0a;
    --surface-hover: #121212;
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.2);
    --text-primary: #ededed;
    --text-muted: #888888;
    --text-subtle: #525252;
    --accent: #3ecf8e;
    --btn-bg: #ffffff;
    --btn-text: #000000;
  }

  :root[data-theme="light"],
  .cawlix-console-root[data-theme="light"] {
    --bg: #ffffff;
    --surface: #fafafa;
    --surface-hover: #f0f0f0;
    --border: rgba(0, 0, 0, 0.08);
    --border-hover: rgba(0, 0, 0, 0.2);
    --text-primary: #111111;
    --text-muted: #666666;
    --text-subtle: #999999;
    --accent: #059669;
    --btn-bg: #000000;
    --btn-text: #ffffff;
  }

  .cawlix-console-root {
    min-height: 100vh;
    background-color: var(--bg);
    color: var(--text-primary);
    font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    transition: background-color 150ms ease, color 150ms ease;
  }

  /* ── 2. Clean Arabic Typography & RTL Foundation ── */
  [dir="rtl"] {
    direction: rtl;
    text-align: right;
    font-family: 'Cairo', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  [dir="rtl"] .header-scope,
  [dir="rtl"] .header-utilities,
  [dir="rtl"] .nav-tabs,
  [dir="rtl"] .command-bar,
  [dir="rtl"] .list-header,
  [dir="rtl"] .list-row,
  [dir="rtl"] .drawer-topbar,
  [dir="rtl"] .drawer-content {
    direction: rtl;
  }

  [dir="rtl"] .list-header .col-delta,
  [dir="rtl"] .list-header .col-price,
  [dir="rtl"] .list-header .col-time,
  [dir="rtl"] .list-row .col-delta,
  [dir="rtl"] .list-row .col-price,
  [dir="rtl"] .list-row .col-time {
    text-align: left;
  }

  [dir="rtl"] .user-dropdown-menu {
    right: auto;
    left: 0;
    text-align: right;
  }

  /* ── Header Row 1: Scope & Utilities ── */
  .header-row-1 {
    height: 48px;
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg);
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-scope {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .slash-divider {
    color: var(--text-subtle);
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
  }

  .scope-selector {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 6px;
    border-radius: 4px;
    cursor: default;
  }

  .scope-avatar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--text-muted);
  }

  .scope-handle {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .chevron-icon {
    color: var(--text-subtle);
  }

  .header-utilities {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .utility-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 120ms ease;
  }

  .utility-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  /* Instant Language Switcher (EN | عربي) */
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 6px;
    background: transparent;
  }

  .lang-btn {
    background: transparent;
    border: none;
    color: var(--text-subtle);
    cursor: pointer;
    font-size: 11px;
    padding: 1px 3px;
    border-radius: 2px;
    transition: color 120ms ease;
  }

  .lang-btn:hover {
    color: var(--text-primary);
  }

  .lang-btn.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .lang-sep {
    color: var(--border);
    user-select: none;
  }

  .util-divider {
    width: 1px;
    height: 14px;
    background-color: var(--border);
  }

  .user-avatar-wrap {
    position: relative;
  }

  .user-avatar-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 120ms ease;
  }

  .user-avatar-circle:hover {
    border-color: var(--border-hover);
  }

  .user-dropdown-menu {
    position: absolute;
    right: 0;
    top: 32px;
    width: 200px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
    z-index: 100;
  }

  .dropdown-header {
    padding: 6px 8px;
    font-size: 10px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu-divider {
    height: 1px;
    background-color: var(--border);
    margin: 3px 0;
  }

  .menu-link, .menu-btn-signout {
    display: block;
    width: 100%;
    text-align: inherit;
    padding: 6px 8px;
    font-size: 12px;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  .menu-link:hover, .menu-btn-signout:hover {
    background-color: var(--surface-hover);
  }

  .menu-btn-signout {
    color: #ef4444;
  }

  /* ── Header Row 2: Borderless Text Tabs with Subtle Active Underline ── */
  .header-row-2 {
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    background-color: var(--bg);
  }

  .nav-tabs {
    display: flex;
    align-items: center;
    gap: 24px;
    overflow-x: auto;
  }

  .nav-tab {
    background: transparent;
    border: none;
    font-size: 12px;
    color: var(--text-muted);
    padding: 10px 0;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
    white-space: nowrap;
    outline: none;
  }

  .nav-tab:hover {
    color: var(--text-primary);
  }

  .nav-tab.active {
    color: var(--text-primary);
    font-weight: 500;
    border-bottom-color: var(--text-primary);
  }

  /* ── Body: Canvas ── */
  .console-body {
    flex: 1;
    background-color: var(--bg);
    padding: 24px;
    box-sizing: border-box;
  }

  .console-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Flat Command Search Bar + High-Contrast Primary Button */
  .command-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .search-wrap {
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 480px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    height: 36px;
    padding: 0 12px;
    gap: 8px;
    box-sizing: border-box;
    transition: border-color 120ms ease;
  }

  .search-wrap:focus-within {
    border-color: var(--border-hover);
  }

  .search-icon {
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 11px;
    outline: none;
    height: 100%;
  }

  .search-input::placeholder {
    color: var(--text-subtle);
  }

  .clear-search-btn {
    background: transparent;
    border: none;
    color: var(--text-subtle);
    font-size: 14px;
    cursor: pointer;
  }

  .btn-primary-add {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    font-size: 11px;
    font-weight: 600;
    padding: 0 14px;
    height: 36px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: opacity 120ms ease;
    white-space: nowrap;
  }

  .btn-primary-add:hover {
    opacity: 0.88;
  }

  .plus-icon {
    font-size: 14px;
    line-height: 1;
  }

  /* ── Tracked List Section (Simple Unadorned Rows) ── */
  .tracked-list-section {
    display: flex;
    flex-direction: column;
  }

  .list-header {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1.2fr 1.2fr 1fr 0.8fr;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 10px;
    color: var(--text-subtle);
    letter-spacing: 0.05em;
  }

  .col-title { min-width: 0; }
  .col-store { min-width: 0; }
  .col-price { text-align: right; }
  .col-delta { text-align: right; }
  .col-time { text-align: right; }
  .col-action { text-align: right; }

  .list-rows-container {
    display: flex;
    flex-direction: column;
  }

  .list-row {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1.2fr 1.2fr 1fr 0.8fr;
    align-items: center;
    padding: 14px 12px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background-color 100ms ease;
  }

  .list-row:hover {
    background-color: var(--surface-hover);
  }

  .row-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding-right: 12px;
  }

  [dir="rtl"] .row-title-wrap {
    padding-right: 0;
    padding-left: 12px;
  }

  .row-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-sku {
    font-size: 10px;
    color: var(--text-subtle);
  }

  .row-store {
    font-size: 11px;
    color: var(--text-muted);
  }

  .row-price {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    text-align: right;
  }

  /* Single subtle monospace text delta: NO boxes, NO pills! */
  .row-delta {
    font-size: 11px;
    font-weight: 600;
    text-align: right;
  }

  .row-delta.markup {
    color: #ef4444;
  }

  .row-delta.deal {
    color: var(--accent);
  }

  .row-time {
    font-size: 11px;
    color: var(--text-muted);
    text-align: right;
  }

  .row-action {
    text-align: right;
  }

  .btn-reaudit {
    background: transparent;
    border: none;
    color: var(--text-subtle);
    font-size: 11px;
    cursor: pointer;
    padding: 2px 0;
    transition: color 120ms ease;
  }

  .btn-reaudit:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .btn-reaudit.probing {
    color: var(--accent);
    cursor: wait;
  }

  .loading-state {
    padding: 36px 0;
    text-align: center;
    color: var(--text-subtle);
    font-size: 11px;
  }

  /* ── 3. Vercel Slide-Over Drawer (Telemetry Inspector) ── */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
  }

  [dir="rtl"] .drawer-overlay {
    justify-content: flex-start;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: fadeInOverlay 140ms ease-out;
  }

  @keyframes fadeInOverlay {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .drawer-panel {
    position: relative;
    width: 100%;
    max-width: 580px;
    height: 100%;
    background-color: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: -20px 0 40px rgba(0, 0, 0, 0.45);
    z-index: 101;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    animation: drawerSlideRight 180ms cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  [dir="rtl"] .drawer-panel {
    border-left: none;
    border-right: 1px solid var(--border);
    box-shadow: 20px 0 40px rgba(0, 0, 0, 0.45);
    animation: drawerSlideLeft 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerSlideRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  @keyframes drawerSlideLeft {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }

  .drawer-topbar {
    height: 48px;
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    display: flex;
