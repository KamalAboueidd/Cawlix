  async function initAuth() {
    try {
      const { data } = await supabase.auth.getSession();
      if (!data?.session) {
        window.location.href = '/login';
        return false;
      }

      const user = data.session.user;
      const email = user?.email || 'developer@cawlix.com';
      const handle = email.split('@')[0];
      
      if (scopeUserName) scopeUserName.textContent = handle;
      if (dropdownEmail) dropdownEmail.textContent = email;
      if (userAvatarInitial) userAvatarInitial.textContent = handle.charAt(0).toUpperCase();

      return true;
    } catch {
      window.location.href = '/login';
      return false;
    }
  }

