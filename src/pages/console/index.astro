      const { data } = await supabase.from<TrackedProduct>('tracked_products').select('*');
      if (loadingIndicator) loadingIndicator.style.display = 'none';

      if (data && data.length > 0) {
        const existingIds = new Set(data.map((d) => d.sku));
        const merged = [...data];
        SEED_CATALOG_ITEMS.forEach((seed) => {
          if (!existingIds.has(seed.sku)) {
            merged.push(seed);
          }
        });
        trackedItems = merged;
      } else {
        trackedItems = SEED_CATALOG_ITEMS;
      }

      renderRows(trackedItems);
    } catch {
      if (loadingIndicator) loadingIndicator.style.display = 'none';
      trackedItems = SEED_CATALOG_ITEMS;
      renderRows(trackedItems);
    }
  }

  // 6. Live Re-audit Fetcher
  async function triggerReaudit(item: TrackedProduct, pingEl?: HTMLElement | null, reauditBtn?: HTMLButtonElement | null) {
    if (reauditBtn) {
      reauditBtn.classList.add('probing');
      reauditBtn.textContent = I18N[currentLang as 'en' | 'ar'].probing;
    }

    try {
      // Live HTTP fetch to SKU telemetry probe API
      await fetch(`/api/v1/telemetry/sku?sku=${encodeURIComponent(item.sku)}&retailer=${encodeURIComponent(item.node)}`);
    } catch {
      // Fallback network simulation
    }

    setTimeout(() => {
      const dict = I18N[currentLang as 'en' | 'ar'];
      item.last_ping = dict.justNow;

      if (reauditBtn) {
        reauditBtn.classList.remove('probing');
        reauditBtn.textContent = dict.btnReaudit;
      }

      if (pingEl) {
        pingEl.textContent = dict.justNow;
        pingEl.style.color = 'var(--accent)';
      }

      const drawerPing = document.getElementById('drawer-ping-text');
      if (drawerPing) {
        drawerPing.textContent = `${dict.telemetryVerified} ${dict.justNow}`;
      }
    }, 450);
  }

  // 7. Render Unadorned List Rows
  function renderRows(items: TrackedProduct[]) {
    if (!rowsContainer) return;
    rowsContainer.innerHTML = '';

    const dict = I18N[currentLang as 'en' | 'ar'] || I18N.en;

    const q = (searchInput?.value || '').toLowerCase().trim();
    const filtered = q
      ? items.filter(
          (item) =>
            item.title.toLowerCase().includes(q) ||
            item.sku.toLowerCase().includes(q) ||
            item.domain.toLowerCase().includes(q) ||
            item.node.toLowerCase().includes(q)
        )
      : items;

    if (filtered.length === 0) {
      rowsContainer.innerHTML = `
        <div style="padding: 40px 0; text-align: center; color: var(--text-subtle); font-family: var(--font-mono, monospace); font-size: 11px;">
          ${dict.noItems}
        </div>
      `;
      return;
    }

    filtered.forEach((item) => {
      const isMarkup = item.delta_pct > 0;
      const deltaClass = isMarkup ? 'markup' : 'deal';
      const deltaSign = item.delta_pct > 0 ? `+${item.delta_pct}%` : `${item.delta_pct}%`;

      const row = document.createElement('div');
      row.className = 'list-row';
      row.setAttribute('data-sku-id', item.id);
      row.innerHTML = `
        <div class="row-title-wrap">
          <span class="row-title">${item.title}</span>
          <span class="row-sku font-mono">${item.sku}</span>
        </div>
        <div class="row-store font-mono">${item.node}</div>
        <div class="row-price font-mono">EGP ${item.current_price_egp.toLocaleString()}</div>
        <div class="row-delta font-mono ${deltaClass}">
          ${deltaSign}
        </div>
        <div class="row-time font-mono" id="ping-${item.id}">${item.last_ping}</div>
        <div class="row-action font-mono">
          <button type="button" class="btn-reaudit font-mono" data-id="${item.id}">
            ${dict.btnReaudit}
          </button>
        </div>
      `;

      // Re-audit trigger (stops propagation so row click isn't triggered)
      const reauditBtn = row.querySelector<HTMLButtonElement>('.btn-reaudit');
      const pingEl = row.querySelector<HTMLElement>(`#ping-${item.id}`);
      reauditBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerReaudit(item, pingEl, reauditBtn);
      });

      // Clicking any row opens the Slide-Over Drawer
      row.addEventListener('click', () => {
        openTelemetryDrawer(item);
      });

      rowsContainer.appendChild(row);
    });
  }

  // 8. Slide-Over Drawer Telemetry Inspector Implementation
  function openTelemetryDrawer(item: TrackedProduct) {
    activeSelectedItem = item;
    populateDrawer(item);
    if (drawerOverlay) {
      drawerOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeTelemetryDrawer() {
    if (drawerOverlay) {
      drawerOverlay.style.display = 'none';
      document.body.style.overflow = '';
      activeSelectedItem = null;
    }
  }

  function getStoreUrl(item: TrackedProduct): string {
    if (item.node.includes('AMZN')) return `https://www.amazon.eg/dp/${item.sku.replace('caw_sku_', 'B0')}`;
    if (item.node.includes('NOON')) return `https://www.noon.com/egypt-en/p-${item.sku}/`;
    if (item.node.includes('BTECH')) return `https://btech.com/en/${item.sku}`;
    if (item.node.includes('2B')) return `https://2b.com.eg/en/catalogsearch/result/?q=${item.sku}`;
    return `https://www.rayashop.com/en/search?q=${item.sku}`;
  }

  function populateDrawer(item: TrackedProduct) {
    if (!drawerContent) return;
    const dict = I18N[currentLang as 'en' | 'ar'] || I18N.en;
    const isMarkup = item.delta_pct > 0;
    const storeUrl = getStoreUrl(item);

    // Landed cost calculations
    const domesticShelf = item.current_price_egp;
    const baseSourceUsd = Math.round(domesticShelf / 62);
    const fxRate = 48.5;
    const baseSourceEgp = Math.round(baseSourceUsd * fxRate);
    const airFreightEgp = 1450;
    const declaredCif = baseSourceEgp + airFreightEgp;
    const customsDutyEgp = Math.round(declaredCif * 0.10);
    const vat14Egp = Math.round((declaredCif + customsDutyEgp) * 0.14);
    const bankFxEgp = Math.round(baseSourceEgp * 0.03);
    const totalLandedEgp = declaredCif + customsDutyEgp + vat14Egp + bankFxEgp;
    const netArbitrageSaved = domesticShelf - totalLandedEgp;
    const isArbitrageAdvantage = netArbitrageSaved > 2000;

    // SVG Chart Geometry
    const strokeColor = isMarkup ? '#ef4444' : '#3ecf8e';
    const baselineY = 55;
    // 90-day trajectory: starts at baseline, shifts depending on markup/deal
    const trendPathD = isMarkup
      ? 'M 20 55 L 140 55 L 220 54 L 300 24 L 380 20 L 460 20'
      : 'M 20 40 L 140 40 L 220 42 L 300 68 L 380 72 L 460 72';
    const endPointY = isMarkup ? 20 : 72;

    drawerContent.innerHTML = `
      <!-- Module 1: Header -->
      <div class="drawer-header-block">
        <div class="drawer-badge-row font-mono">
          <span class="drawer-sku-id">${item.sku}</span>
          <span>·</span>
          <span class="drawer-store-node">${item.node}</span>
          <span class="text-subtle">(${item.domain})</span>
        </div>
        <h2 id="drawer-item-title" class="drawer-title">${item.title}</h2>
        <div class="drawer-actions-row">
          <a href="${storeUrl}" target="_blank" rel="noopener noreferrer" class="drawer-ext-link font-mono">
            ${dict.openNode}
          </a>
          <span class="drawer-ping-status font-mono" id="drawer-ping-text">
            ${dict.telemetryVerified} ${item.last_ping}
          </span>
        </div>
      </div>

      <!-- Module 2: Forensic Price Diagnostic -->
      <div class="drawer-section-module">
        <span class="drawer-module-title font-mono">${dict.modDiagnostic}</span>
        
        <div class="diagnostic-grid">
          <div class="diag-item">
            <span class="diag-label font-mono">${dict.currentShelfPrice}</span>
            <span class="diag-val font-mono">EGP ${item.current_price_egp.toLocaleString()}</span>
            <span class="diag-delta-sub font-mono ${isMarkup ? 'markup' : 'deal'}">
              ${isMarkup ? `+${item.delta_pct}% ${dict.overBaseline}` : `${item.delta_pct}% ${dict.underBaseline}`}
            </span>
          </div>

          <div class="diag-item">
            <span class="diag-label font-mono">${dict.baselineMedian}</span>
            <span class="diag-val font-mono">EGP ${item.baseline_price_egp.toLocaleString()}</span>
            <span class="diag-delta-sub font-mono text-subtle">
              90-day median rolling baseline
            </span>
          </div>
        </div>

        <div class="verdict-box font-mono ${isMarkup ? 'markup' : 'deal'}">
          <div class="verdict-tag ${isMarkup ? 'markup' : 'deal'}">${dict.verdictLabel}</div>
          <div class="verdict-desc">${isMarkup ? dict.verdictFakeMarkup : dict.verdictRealDeal}</div>
        </div>
      </div>

      <!-- Module 3: Price History Trend (90-Day Trajectory Sparkline) -->
      <div class="drawer-section-module">
        <span class="drawer-module-title font-mono">${dict.modHistoryTrend}</span>
        
        <div class="chart-container">
          <div class="chart-svg-wrap">
            <svg width="100%" height="100" viewBox="0 0 480 100" preserveAspectRatio="none" fill="none">
              <!-- Dashed Baseline Reference Line -->
              <line x1="10" y1="${baselineY}" x2="470" y2="${baselineY}" stroke="var(--text-subtle)" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.5" />
              <text x="14" y="${baselineY - 6}" fill="var(--text-subtle)" font-size="9" font-family="monospace">
                MEDIAN BASELINE: EGP ${item.baseline_price_egp.toLocaleString()}
              </text>

              <!-- Trend Polyline -->
              <path d="${trendPathD}" stroke="${strokeColor}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

              <!-- Endpoint Pulse -->
              <circle cx="460" cy="${endPointY}" r="4" fill="${strokeColor}" />
              <circle cx="460" cy="${endPointY}" r="8" stroke="${strokeColor}" stroke-width="1.2" stroke-opacity="0.4" />
            </svg>
          </div>

          <div class="chart-axis-labels font-mono">
            <span>${dict.axisStart}</span>
            <span>${dict.axisPreSale}</span>
            <span>${dict.axisNow}: EGP ${item.current_price_egp.toLocaleString()}</span>
          </div>
        </div>
      </div>

      <!-- Module 4: Landed Cost Comparison (Arbitrage Engine) -->
      <div class="drawer-section-module">
        <span class="drawer-module-title font-mono">${dict.modLandedCost}</span>

        <div class="landed-cost-table font-mono">
          <div class="landed-row">
            <span class="landed-label">${dict.rowDomesticRetail}</span>
            <span class="landed-value">EGP ${domesticShelf.toLocaleString()}</span>
          </div>
          <div class="landed-row">
            <span class="landed-label">${dict.rowCifImport}</span>
            <span class="landed-value">EGP ${declaredCif.toLocaleString()} ($${baseSourceUsd})</span>
          </div>
          <div class="landed-row">
            <span class="landed-label">${dict.rowCustomsDuty}</span>
            <span class="landed-value">EGP ${customsDutyEgp.toLocaleString()} (10%)</span>
          </div>
          <div class="landed-row">
            <span class="landed-label">${dict.rowVat}</span>
            <span class="landed-value">EGP ${vat14Egp.toLocaleString()} (14%)</span>
          </div>
          <div class="landed-row">
            <span class="landed-label">${dict.rowBankFx}</span>
            <span class="landed-value">EGP ${bankFxEgp.toLocaleString()}</span>
          </div>
          <div class="landed-row">
            <span class="landed-label font-bold">${dict.rowTotalLanded}</span>
            <span class="landed-value font-bold">EGP ${totalLandedEgp.toLocaleString()}</span>
          </div>
        </div>

        <div class="arbitrage-verdict-banner font-mono ${isArbitrageAdvantage ? 'positive' : ''}">
          <span class="font-bold">${isArbitrageAdvantage ? dict.verdictImportRec : dict.verdictDomesticRec}</span>
          <span>
            ${isArbitrageAdvantage ? `+EGP ${netArbitrageSaved.toLocaleString()} ${dict.savingsText}` : 'Direct domestic purchase is cost-optimal'}
          </span>
        </div>
      </div>

      <!-- Module 5: Alert Trigger Settings -->
      <div class="drawer-section-module">
        <span class="drawer-module-title font-mono">${dict.modAlertSettings}</span>

        <div class="alert-input-group">
          <div class="alert-input-wrap">
            <span class="alert-prefix font-mono">EGP</span>
            <input
              type="number"
              id="drawer-alert-price-input"
              class="alert-field font-mono"
              placeholder="e.g. ${Math.round(item.baseline_price_egp * 0.95)}"
              value="${Math.round(item.baseline_price_egp * 0.95)}"
            />
          </div>
          <button type="button" id="btn-save-drawer-alert" class="btn-save-alert font-mono">
            ${dict.saveAlertRule}
          </button>
        </div>
      </div>
    `;

    // Bind save alert action
    const btnSaveAlert = drawerContent.querySelector<HTMLButtonElement>('#btn-save-drawer-alert');
    const alertInput = drawerContent.querySelector<HTMLInputElement>('#drawer-alert-price-input');
    btnSaveAlert?.addEventListener('click', async () => {
      const targetVal = parseFloat(alertInput?.value || '0');
      btnSaveAlert.textContent = 'SAVING...';
      
      try {
        await supabase.from('user_watchlists').upsert({
          sku: item.sku,
          target_alert_price: targetVal,
          glitch_radar_enabled: true,
          updated_at: new Date().toISOString(),
        });
      } catch {
        // Fallback
      }

      setTimeout(() => {
        btnSaveAlert.textContent = dict.alertSaved;
        btnSaveAlert.classList.add('saved');
        setTimeout(() => {
          btnSaveAlert.textContent = dict.saveAlertRule;
          btnSaveAlert.classList.remove('saved');
        }, 2200);
      }, 350);
    });
  }

  // 9. Drawer event listeners
  btnCloseDrawer?.addEventListener('click', closeTelemetryDrawer);
  drawerBackdrop?.addEventListener('click', closeTelemetryDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (drawerOverlay && drawerOverlay.style.display !== 'none') {
        closeTelemetryDrawer();
      }
    }
  });

  // 10. Search input
  searchInput?.addEventListener('input', () => {
    if (btnClearSearch) btnClearSearch.style.display = searchInput.value ? 'block' : 'none';
    renderRows(trackedItems);
  });

  btnClearSearch?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (btnClearSearch) btnClearSearch.style.display = 'none';
    renderRows(trackedItems);
  });

  // 11. User menu & Modal Triggers
  btnAvatar?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (userDropdown) {
      userDropdown.style.display = userDropdown.style.display === 'none' ? 'block' : 'none';
    }
  });

  document.addEventListener('click', () => {
    if (userDropdown) userDropdown.style.display = 'none';
  });

  btnSignOut?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  btnAddSku?.addEventListener('click', () => {
    if (addModalOverlay) {
      addModalOverlay.style.display = 'flex';
    }
  });

  // Initialize
  initTheme();
  initLang();

  (async () => {
    const authed = await initAuth();
    if (authed) {
      await loadTrackedProducts();
    }
  })();
</script>
