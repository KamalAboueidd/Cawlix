---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/astro/Navbar.astro';
import Footer from '../../components/astro/Footer.astro';
---

<Layout
  title="API Sandbox & Developer Endpoints — Cawlix Tracker"
  description="Explore the Cawlix REST API, live price probe endpoints, and webhook stream protocol."
>
  <Navbar />

  <main style="min-height: 100vh; background-color: #0A0A0A; padding-top: 130px; padding-bottom: 100px;">
    <div style="max-width: 960px; margin: 0 auto; padding: 0 24px;">
      <div style="margin-bottom: 48px;">
        <span class="feature-group-label" style="color: #3ECF8E; margin-bottom: 12px;">
          // REST_API_v1_REFERENCE
        </span>
        <h1
          class="text-display"
          style="font-size: clamp(2.25rem, 4.5vw, 3.5rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.1; margin: 0 0 16px 0;"
        >
          Programmatic Price Intelligence
        </h1>
        <p style="font-size: 1.0625rem; color: #888888; line-height: 1.6; margin: 0;">
          Deterministic JSON responses for SKU verification, time-series audits, and landed-cost parity.
        </p>
      </div>

      <!-- Sample Endpoint Card -->
      <div style="background: #111111; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden; margin-bottom: 32px;">
        <div style="padding: 16px 20px; background: #161616; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.8125rem;">
            <span style="background: #3ECF8E; color: #0A0A0A; font-weight: 700; padding: 2px 8px; border-radius: 4px;">GET</span>
            <span style="color: #FFFFFF;">https://api.cawlix.com/v1/telemetry/probe?sku=SONY-WH-1000XM5</span>
          </div>
          <span style="color: #737373; font-family: var(--font-mono); font-size: 0.6875rem;">Auth: Bearer Token</span>
        </div>

        <div style="padding: 24px; font-family: var(--font-mono); font-size: 0.8125rem; background: #0A0A0A; color: #D4D4D4; line-height: 1.6; overflow-x: auto;">
          <pre style="margin: 0;">{`{
  "sku": "SONY-WH-1000XM5",
  "status": "FLAGGED",
  "ghost_score": 22,
  "authentic_baseline_egp": 24000,
  "current_listed_price_egp": 28320,
  "artificial_spike_detected": true,
  "spike_magnitude": "+18.0%",
  "retailers_polled": 12,
  "fastest_probe_latency_ms": 78,
  "us_import_landed_parity": {
    "us_msrp_usd": 399,
    "fx_rate": 50.48,
    "tariff_code": "8517.13",
    "tariff_pct": 0,
    "statutory_vat_pct": 14,
    "total_landed_cost_egp": 22850
  }
}`}</pre>
        </div>
      </div>

      <div style="display: flex; gap: 12px;">
        <a
          href="/pricing"
          style="background: #3ECF8E; color: #0A0A0A; font-weight: 700; font-size: 0.875rem; padding: 10px 20px; border-radius: 8px; text-decoration: none;"
        >
          Request Developer API Key
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
