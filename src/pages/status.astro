---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';

const NODES = [
  { name: 'Amazon Egypt Scraper Cluster', region: 'Cairo North', status: 'OPERATIONAL', latency: '94ms', uptime: '100%' },
  { name: 'Noon EG Real-Time Stream', region: 'Cairo West', status: 'OPERATIONAL', latency: '112ms', uptime: '99.98%' },
  { name: 'B.TECH Telemetry Node', region: 'Giza Hub', status: 'OPERATIONAL', latency: '78ms', uptime: '100%' },
  { name: 'TradeLine Store Sentinel', region: 'Alexandria Hub', status: 'OPERATIONAL', latency: '124ms', uptime: '100%' },
  { name: '2B Egypt Price Probe', region: 'Cairo East', status: 'OPERATIONAL', latency: '88ms', uptime: '100%' },
  { name: 'JFK Air Freight Corridors', region: 'US East Coast', status: 'OPERATIONAL', latency: '165ms', uptime: '100%' },
];
---

<Layout
  title="System & Scraper Network Status — Cawlix Tracker"
  description="Real-time operational status of the Cawlix retail price ingestion network, scrape cluster health, and probe latencies."
>
  <Navbar />

  <main style="min-height: 100vh; background-color: #0A0A0A; padding-top: 130px; padding-bottom: 100px;">
    <div style="max-width: 960px; margin: 0 auto; padding: 0 24px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 16px;">
        <div>
          <span class="feature-group-label" style="color: #3ECF8E; margin-bottom: 12px;">
            Telemetry Grid Health
          </span>
          <h1
            class="text-display"
            style="font-size: clamp(2.25rem, 4.5vw, 3.5rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.1; margin: 0;"
          >
            All Systems Operational
          </h1>
        </div>

        <div style="display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.75rem; color: #3ECF8E;">
          <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #3ECF8E;"></span>
          <span>Cluster Uptime: 99.98%</span>
        </div>
      </div>

      <!-- Nodes Table -->
      <div style="background: transparent; border: none; border-radius: 0; overflow: hidden;">
        <div style="padding: 12px 0; background: transparent; border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-family: var(--font-mono); font-size: 0.6875rem; color: #737373; text-transform: uppercase;">
          Active Probe Clusters
        </div>
        <div style="display: flex; flex-direction: column;">
          {NODES.map((node) => (
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.04); font-family: var(--font-mono); font-size: 0.75rem; flex-wrap: wrap; gap: 10px;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #3ECF8E;"></span>
                <span style="color: #FFFFFF; font-weight: 600;">{node.name}</span>
                <span style="color: #737373; font-size: 0.6875rem;">({node.region})</span>
              </div>
              <div style="display: flex; gap: 20px; color: #888888;">
                <span>LATENCY: <strong style="color: #D4D4D4;">{node.latency}</strong></span>
                <span>UPTIME: <strong style="color: #3ECF8E;">{node.uptime}</strong></span>
                <span style="color: #3ECF8E; background: rgba(62, 207, 142, 0.1); padding: 2px 6px; border-radius: 4px;">{node.status}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
